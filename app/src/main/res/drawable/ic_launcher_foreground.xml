<?xml version="1.0" encoding="utf-8"?>
<!-- Cápsula del icono con la paleta Blíster: mitad blanca (Paper) y mitad coral, con relieve de
     gel, un contorno tinta muy suave y una sombra difusa que la separa del aluminio. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sombra: capas tinta casi transparentes y desplazadas hacia abajo, a falta de desenfoque -->
    <path
        android:pathData="M38,45 L70,45 A13,13 0 0,1 70,71 L38,71 A13,13 0 0,1 38,45 Z"
        android:fillColor="#18202C"
        android:fillAlpha="0.06" />
    <path
        android:pathData="M39,46 L69,46 A12,12 0 0,1 69,70 L39,70 A12,12 0 0,1 39,46 Z"
        android:fillColor="#18202C"
        android:fillAlpha="0.08" />

    <!-- Mitad izquierda: blanco con gel -->
    <path android:pathData="M54,43 L39,43 A11,11 0 0,0 39,65 L54,65 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="43"
                android:endX="0"
                android:endY="65">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.55" android:color="#FFF1F3F6" />
                <item android:offset="1" android:color="#FFD3D8DF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Mitad derecha: coral con gel -->
    <path android:pathData="M54,43 L69,43 A11,11 0 0,1 69,65 L54,65 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="43"
                android:endX="0"
                android:endY="65">
                <item android:offset="0" android:color="#FFFF9A90" />
                <item android:offset="0.5" android:color="#FFFF5A4F" />
                <item android:offset="1" android:color="#FFD63F35" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Junta entre las dos mitades -->
    <path
        android:pathData="M53.5,43 L54.5,43 L54.5,65 L53.5,65 Z"
        android:fillColor="#18202C"
        android:fillAlpha="0.2" />

    <!-- Contorno -->
    <path
        android:pathData="M39,43 L69,43 A11,11 0 0,1 69,65 L39,65 A11,11 0 0,1 39,43 Z"
        android:strokeColor="#18202C"
        android:strokeAlpha="0.28"
        android:strokeWidth="1" />

    <!-- Brillo del gel -->
    <path android:pathData="M35.5,45.2 L72.5,45.2 A3.5,3.5 0 0,1 72.5,52.2 L35.5,52.2 A3.5,3.5 0 0,1 35.5,45.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="45.2"
                android:endX="0"
                android:endY="52.2"
                android:startColor="#D9FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>
</vector>
